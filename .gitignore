._*
.DS_Store

# Local secrets — build-time keys, never commit or ship.
scripts/secrets.local.js
*.key.local.js
*.local.key
data/votes_checkpoint.json
data/news_debug.txt

# Device-bridge deletion workaround — sessions can move but not delete;
# trash this folder by hand whenever, git never sees it.
_to_delete/
.claude/

# auto-published drafts move aside locally (publish-draft.js)
data/readings/drafts/claude/_published/

# push-gate: tooling + the transient key file (never committed)
push-gate/node_modules/
push-gate/.vapid.tmp
push-gate/.wrangler/

# ted-gate: the deploy tool (never committed)
ted-gate/node_modules/
ted-gate/.wrangler/

# the show (scripts/show): puppeteer install and rendered output
node_modules/
data/show/*/frames/
data/show/*/beats/
data/show/*/*.mp4
data/show/*/*.mp3
data/show/*/concat.txt

# raw material from the Mac-side pulls — never published (the paper carries reductions and short quotes, not transcripts)
data/press/transcripts/
